def _read_version() -> str:
    try:
        v = VERSION_FILE.read_text().strip()
        return v if v else "unknown"
    except OSError:
        return "unknown"


def _fetch_json(url: str, timeout: int = 15) -> dict:
    req = urllib.request.Request(url, headers=HEADERS)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def _fetch_bytes(url: str, timeout: int = 60) -> bytes:
    req = urllib.request.Request(url, headers=HEADERS)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


# ── Workers ───────────────────────────────────────────────────────────────────

class SequentialRunner(QThread):
    """Run a list of commands sequentially, stream output."""
    line     = pyqtSignal(str)
    finished = pyqtSignal(int)

    def __init__(self, commands: list[list[str]]):
        super().__init__()
        self.commands = commands

    def run(self):
        last_rc = 0
        for cmd in self.commands:
            self.line.emit(f"\n$ {' '.join(cmd)}")
            try:
                proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, bufsize=1,
                )
                for ln in proc.stdout:
                    self.line.emit(ln.rstrip())
                proc.wait()
                last_rc = proc.returncode
                if last_rc != 0:
                    self.line.emit(f"[exited with code {last_rc}]")
            except FileNotFoundError as e:
                self.line.emit(f"[error: {e}]")
                last_rc = 1
        self.finished.emit(last_rc)


class NetChecker(QThread):
    """Fetch the latest OS commit info from GitHub."""
    done  = pyqtSignal(dict)
    error = pyqtSignal(str)

    def run(self):
        try:
            data = _fetch_json(OS_API_URL)
            self.done.emit({
                "sha":     data["sha"],
                "short":   data["sha"][:8],
                "message": data["commit"]["message"].split("\n")[0],
                "date":    data["commit"]["author"]["date"][:10],
            })
        except Exception as e:
            self.error.emit(str(e))


class ScriptFetcher(QThread):
    """Download update.sh into a temp file."""
    ready = pyqtSignal(str, str)
    error = pyqtSignal(str)

    def __init__(self, sha: str):
        super().__init__()
        self.sha = sha

    def run(self):
        try:
            content = _fetch_bytes(OS_UPDATE_URL, timeout=30)
            fd, path = tempfile.mkstemp(prefix="vertex-os-update-", suffix=".sh")
            os.write(fd, content)
            os.close(fd)
            os.chmod(path, 0o755)
            self.ready.emit(path, self.sha)
        except Exception as e:
            self.error.emit(str(e))


class ToolFetcher(QThread):
    """Download vertex-drivers, vpkg, and/or vertex-update and install them."""
    line     = pyqtSignal(str)
    finished = pyqtSignal(int)   # 0 = success
    self_updated = pyqtSignal()  # emitted when vertex-update itself was replaced

    def __init__(self, do_drivers: bool, do_vpkg: bool, do_self: bool):
        super().__init__()
        self.do_drivers = do_drivers
        self.do_vpkg    = do_vpkg
        self.do_self    = do_self

    def _emit(self, msg: str):
        self.line.emit(msg)

    def run(self):
        tmpfiles: list[tuple[str, str]] = []   # (tmp_path, dest_path)
        errors = 0

        # ── vertex-drivers from latest GitHub release ─────────────────────────
        if self.do_drivers:
            self._emit("Fetching latest vertex-drivers release…")
            try:
                data    = _fetch_json(DRIVERS_API)
                tag     = data["tag_name"]
                asset_url = next(
                    (a["browser_download_url"] for a in data.get("assets", [])
                     if a["name"] == "vertex-drivers"),
                    None,
                )
                if not asset_url:
                    self._emit(f"  [error] No 'vertex-drivers' asset in release {tag}")
                    errors += 1
                else:
                    self._emit(f"  Downloading vertex-drivers {tag}…")
                    content = _fetch_bytes(asset_url)
                    fd, tmp = tempfile.mkstemp(prefix="vertex-drivers-")
                    os.write(fd, content)
                    os.close(fd)
                    tmpfiles.append((tmp, "/usr/local/bin/vertex-drivers"))
                    self._emit(f"  vertex-drivers {tag} ready  ({len(content)//1024} KB)")
            except Exception as e:
                self._emit(f"  [error] vertex-drivers: {e}")
                errors += 1

        # ── vpkg from vertex-tools main branch ───────────────────────────────
        if self.do_vpkg:
            self._emit("Fetching latest vpkg…")
            try:
                content = _fetch_bytes(f"{TOOLS_RAW}/vpkg")
                fd, tmp = tempfile.mkstemp(prefix="vertex-vpkg-")
                os.write(fd, content)
                os.close(fd)
                tmpfiles.append((tmp, "/usr/local/bin/vpkg"))
                self._emit(f"  vpkg ready  ({len(content)} bytes)")
            except Exception as e:
                self._emit(f"  [error] vpkg: {e}")
                errors += 1

        # ── vertex-update (self) from vertex-tools main branch ───────────────
        if self.do_self:
            self._emit("Fetching latest vertex-update…")
            try:
                content = _fetch_bytes(f"{TOOLS_RAW}/vertex-update")
                fd, tmp = tempfile.mkstemp(prefix="vertex-update-")
                os.write(fd, content)
                os.close(fd)
                tmpfiles.append((tmp, "/usr/local/bin/vertex-update"))
                self._emit(f"  vertex-update ready  ({len(content)} bytes)")
            except Exception as e:
                self._emit(f"  [error] vertex-update: {e}")
                errors += 1

        if not tmpfiles:
            self._emit("Nothing downloaded — cannot install.")
            self.finished.emit(1)
            return

        # ── Install all files with a single pkexec call ───────────────────────
        self._emit("\nInstalling with elevated privileges…")
        cmds = " && ".join(
            f"cp '{src}' '{dst}' && chmod 755 '{dst}'"
            for src, dst in tmpfiles
        )
        proc = subprocess.Popen(
            ["pkexec", "bash", "-c", cmds],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        )
        for ln in proc.stdout:
            self._emit(ln.rstrip())
        proc.wait()

        # Clean up temp files
        for src, _ in tmpfiles:
            try:
                os.unlink(src)
            except OSError:
                pass

        if proc.returncode == 0:
            self._emit("\nAll tools installed successfully.")
            installed_self = any(dst == "/usr/local/bin/vertex-update"
                                 for _, dst in tmpfiles)
            if installed_self:
                self.self_updated.emit()
        else:
            self._emit(f"\n[install exited with code {proc.returncode}]")
            errors += 1

        self.finished.emit(0 if errors == 0 else 1)


# ── Main window ───────────────────────────────────────────────────────────────

class VertexUpdater(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Vertex Updater")
        self.setMinimumSize(860, 720)
        self._latest_info: dict | None = None
        self._update_sha  = ""
        self._busy        = False
        self._worker      = None
        self._build_ui()

    def _build_ui(self):
        root = QWidget()
        self.setCentralWidget(root)
        lay = QVBoxLayout(root)
        lay.setContentsMargins(24, 18, 24, 18)
        lay.setSpacing(12)

        # ── Header ────────────────────────────────────────────────────────────
        hdr = QHBoxLayout()
        title = QLabel("Vertex Updater")
        title.setStyleSheet("font-size: 22px; font-weight: bold; color: #A78BFA;")
        sub = QLabel("Keep your Vertex Linux system up to date")
        sub.setStyleSheet("color: #6D5FA0; font-size: 12px;")
        hdr.addWidget(title)
        hdr.addSpacing(14)
        hdr.addWidget(sub, alignment=Qt.AlignmentFlag.AlignVCenter)
        hdr.addStretch()
        lay.addLayout(hdr)

        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine)
        sep.setStyleSheet("color: #2D1B69;")
        lay.addWidget(sep)

        # ── Package updates ───────────────────────────────────────────────────
        pkg_box = QGroupBox("Package Updates")
        pkg_lay = QVBoxLayout(pkg_box)
        pkg_lay.setSpacing(8)

        self.chk_pacman  = QCheckBox("System packages  (vpkg pm update)")
        self.chk_flatpak = QCheckBox("Flatpak applications  (vpkg fp update)")
        self.chk_aur     = QCheckBox("AUR packages  (vpkg aur — git + makepkg)")

        for chk in (self.chk_pacman, self.chk_aur, self.chk_flatpak):
            chk.setChecked(True)
            pkg_lay.addWidget(chk)

        self.btn_pkg = QPushButton("Update Packages")
        r = QHBoxLayout()
        r.addWidget(self.btn_pkg)
        r.addStretch()
        pkg_lay.addLayout(r)
        lay.addWidget(pkg_box)
        self.btn_pkg.clicked.connect(self._run_pkg_updates)

        # ── Tool updates ──────────────────────────────────────────────────────
        tool_box = QGroupBox("Vertex Tool Updates  (from GitHub)")
        tool_lay = QVBoxLayout(tool_box)
        tool_lay.setSpacing(8)

        self.chk_drivers = QCheckBox(
            "Vertex Driver Manager  (arc360alt/vertex-graphics-installer — latest release)"
        )
        self.chk_vpkg = QCheckBox(
            "vpkg package manager  (arc360alt/vertex-tools)"
        )
        self.chk_self = QCheckBox(
            "Vertex Updater itself  (arc360alt/vertex-tools)"
        )
        for chk in (self.chk_drivers, self.chk_vpkg, self.chk_self):
            chk.setChecked(True)
            tool_lay.addWidget(chk)

        self.btn_tools = QPushButton("Update Tools")
        tr = QHBoxLayout()
        tr.addWidget(self.btn_tools)
        tr.addStretch()
        tool_lay.addLayout(tr)
        lay.addWidget(tool_box)
        self.btn_tools.clicked.connect(self._run_tool_updates)

        # ── OS update ─────────────────────────────────────────────────────────
        os_box = QGroupBox("OS Update  (syncs system config from GitHub commits)")
        os_lay = QVBoxLayout(os_box)
        os_lay.setSpacing(8)

        ver_row = QHBoxLayout()
        ver_row.addWidget(QLabel("Installed:"))
        self.lbl_cur = QLabel(_read_version())
        self.lbl_cur.setStyleSheet("font-family: monospace; color: #7C6BAC;")
        ver_row.addWidget(self.lbl_cur)
        ver_row.addSpacing(28)
        ver_row.addWidget(QLabel("Latest:"))
        self.lbl_new = QLabel("(not checked)")
        self.lbl_new.setStyleSheet("font-family: monospace; color: #6D5FA0;")
        ver_row.addWidget(self.lbl_new)
        ver_row.addStretch()
        os_lay.addLayout(ver_row)

        self.lbl_msg = QLabel("")
        self.lbl_msg.setStyleSheet("color: #7C6BAC; font-style: italic;")
        os_lay.addWidget(self.lbl_msg)

        os_btn_row = QHBoxLayout()
        self.btn_check = QPushButton("Check for Updates")
        self.btn_check.setProperty("secondary", True)
        self.btn_check.style().polish(self.btn_check)
        self.btn_apply = QPushButton("Apply OS Update")
        self.btn_apply.setEnabled(False)
        os_btn_row.addWidget(self.btn_check)
        os_btn_row.addSpacing(10)
        os_btn_row.addWidget(self.btn_apply)
        os_btn_row.addStretch()
        os_lay.addLayout(os_btn_row)
        lay.addWidget(os_box)

        self.btn_check.clicked.connect(self._check_os)
        self.btn_apply.clicked.connect(self._run_os_update)

        # ── Log ───────────────────────────────────────────────────────────────
        lbl_log = QLabel("Output Log")
        lbl_log.setStyleSheet("color: #6D5FA0; font-size: 11px; font-weight: bold;")
        lay.addWidget(lbl_log)

        self.log = QTextEdit()
        self.log.setReadOnly(True)
        self.log.setMinimumHeight(160)
        lay.addWidget(self.log)

        self.lbl_status = QLabel("Ready.")
        self.lbl_status.setStyleSheet("color: #6D5FA0; font-size: 12px;")
        lay.addWidget(self.lbl_status)

    # ── Package update flow ───────────────────────────────────────────────────

    def _run_pkg_updates(self):
        if self._busy:
            return
        cmds: list[list[str]] = []
        if self.chk_pacman.isChecked():
            cmds.append(["pkexec", "vpkg", "pm", "update", "--noconfirm"])
        if self.chk_aur.isChecked():
            cmds.append(["vpkg", "aur", "update"])
        if self.chk_flatpak.isChecked():
            cmds.append(["pkexec", "vpkg", "fp", "update"])
        if not cmds:
            self._log("Nothing selected.")
            return
        self._set_busy(True)
        self._status("Updating packages…")
        self._worker = SequentialRunner(cmds)
        self._worker.line.connect(self._log)
        self._worker.finished.connect(self._on_pkg_done)
        self._worker.start()

    def _on_pkg_done(self, rc: int):
        self._set_busy(False)
        if rc == 0:
            self._status("Package updates complete.", "ok")
        else:
            self._status(f"Finished with errors (exit {rc}).", "warn")

    # ── Tool update flow ──────────────────────────────────────────────────────

    def _run_tool_updates(self):
        if self._busy:
            return
        do_drivers = self.chk_drivers.isChecked()
        do_vpkg    = self.chk_vpkg.isChecked()
        do_self    = self.chk_self.isChecked()
        if not any([do_drivers, do_vpkg, do_self]):
            self._log("No tools selected.")
            return
        self._set_busy(True)
        self._status("Downloading tool updates…")
        self._log("=== Vertex Tool Updates ===")
        self._worker = ToolFetcher(do_drivers, do_vpkg, do_self)
        self._worker.line.connect(self._log)
        self._worker.finished.connect(self._on_tools_done)
        self._worker.self_updated.connect(self._on_self_updated)
        self._worker.start()

    def _on_tools_done(self, rc: int):
        self._set_busy(False)
        if rc == 0:
            self._status("Tool updates applied.", "ok")
        else:
            self._status("Tool update finished with errors — check log.", "warn")

    def _on_self_updated(self):
        self._log(
            "\n  Vertex Updater was replaced on disk.\n"
            "  Close and relaunch this app to run the new version."
        )

    # ── OS update flow ────────────────────────────────────────────────────────

    def _check_os(self):
        if self._busy:
            return
        self._set_busy(True)
        self._status("Checking for OS updates…")
        self.lbl_new.setText("checking…")
        self.lbl_new.setStyleSheet("font-family: monospace; color: #6D5FA0;")
        self.btn_apply.setEnabled(False)
        self._worker = NetChecker()
        self._worker.done.connect(self._on_check_done)
        self._worker.error.connect(self._on_check_error)
        self._worker.start()

    def _on_check_done(self, info: dict):
        self._set_busy(False)
        self._latest_info = info
        current = _read_version()
        self.lbl_cur.setText(current)
        self.lbl_new.setText(f"{info['short']}  ({info['date']})")
        self.lbl_msg.setText(info["message"])
        up_to_date = (current != "unknown" and current == info["sha"])
        if up_to_date:
            self.lbl_new.setStyleSheet("font-family: monospace; color: #6D5FA0;")
            self._status("OS is up to date.", "ok")
            self.btn_apply.setEnabled(False)
        else:
            self.lbl_new.setStyleSheet("font-family: monospace; color: #34D399;")
            self._status("OS update available!", "ok")
            self.btn_apply.setEnabled(True)

    def _on_check_error(self, msg: str):
        self._set_busy(False)
        self.lbl_new.setText("error")
        self._status(f"Could not check for updates: {msg}", "error")

    def _run_os_update(self):
        if self._busy or not self._latest_info:
            return
        self._set_busy(True)
        self._log("=== Downloading OS update script…")
        self._worker = ScriptFetcher(self._latest_info["sha"])
        self._worker.ready.connect(self._on_script_ready)
        self._worker.error.connect(self._on_script_error)
        self._worker.start()

    def _on_script_ready(self, path: str, sha: str):
        self._update_sha = sha
        self._log(f"Script downloaded. Running with elevated privileges…")
        self._worker = SequentialRunner([
            ["pkexec", "bash", path],
            ["pkexec", "bash", "-c", f"echo '{sha}' > /etc/vertex-release"],
        ])
        self._worker.line.connect(self._log)
        self._worker.finished.connect(self._on_os_done)
        self._worker.start()

    def _on_script_error(self, msg: str):
        self._set_busy(False)
        self._status(f"Download failed: {msg}", "error")

    def _on_os_done(self, rc: int):
        self._set_busy(False)
        if rc == 0:
            self.lbl_cur.setText(self._update_sha[:8])
            self.btn_apply.setEnabled(False)
            self._status("OS update applied successfully!", "ok")
        else:
            self._status(f"OS update finished with errors (exit {rc}).", "warn")

    # ── Helpers ───────────────────────────────────────────────────────────────

    def _log(self, text: str):
        self.log.append(text)
        self.log.verticalScrollBar().setValue(
            self.log.verticalScrollBar().maximum()
        )

    def _status(self, text: str, level: str = ""):
        colors = {"ok": "#34D399", "warn": "#F59E0B", "error": "#F87171", "": "#6D5FA0"}
        self.lbl_status.setStyleSheet(
            f"color: {colors.get(level, '#6D5FA0')}; font-size: 12px;"
        )
        self.lbl_status.setText(text)

    def _set_busy(self, busy: bool):
        self._busy = busy
        for btn in (self.btn_pkg, self.btn_tools, self.btn_check, self.btn_apply):
            btn.setEnabled(not busy)
        if not busy and self._latest_info:
            current = _read_version()
            self.btn_apply.setEnabled(
                current == "unknown" or current != self._latest_info["sha"]
            )


def main():
    app = QApplication(sys.argv)
    app.setStyleSheet(STYLESHEET)
    app.setApplicationName("Vertex Updater")
    win = VertexUpdater()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
